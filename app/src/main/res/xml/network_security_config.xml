<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext is allowed at OS level; Locky's "HTTPS only" setting (on by default) upgrades http:// in the app. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
